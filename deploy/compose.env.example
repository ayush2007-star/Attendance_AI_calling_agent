# Copy this file to deploy/.env. Replace every placeholder before deployment.
POSTGRES_PASSWORD=replace-with-url-safe-random-password
DATABASE_URL=postgresql+psycopg://attendance_app:replace-with-url-safe-random-password@db:5432/attendance_ai_agent
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=
WEB_PORT=8080
