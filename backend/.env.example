APP_NAME=Attendance AI Agent
APP_VERSION=1.0.0
ENVIRONMENT=development
AUTO_SEED_DEMO_DATA=false

DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/attendance_ai_agent
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=

# Voice Agent Integration (defaults to safe mock mode; keep false for local testing)
REAL_CALLS_ENABLED=false
EXTERNAL_AI_PROCESSING_APPROVED=false
VOICE_AGENT_BASE_URL=http://127.0.0.1:8001
VOICE_AGENT_API_KEY=
CALLING_PROVIDER=mock
